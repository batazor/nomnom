// Тестовое окружение (ADR 14, ADR 34). Неймспейсы — ops/kind/manifests/base/namespaces.yaml.
deployment {
  cluster nomnomTest 'kind: nomnom-test' {
    namespace gatewaySystem 'envoy-gateway-system' {
      instanceOf nomnom.cell1.internalGateway
    }
    namespace gatewayNs 'nomnom-gateway' {
      instanceOf nomnom.publicGateway
    }
    namespace controlplaneNs 'nomnom-controlplane' {
      instanceOf nomnom.controlplane
    }
    namespace uiNs 'nomnom-ui' {
      instanceOf nomnom.ui
    }
    namespace bffNs 'nomnom-bff' {
      instanceOf nomnom.cell1.router
    }
    namespace ordersNs 'nomnom-orders' {
      instanceOf nomnom.cell1.orders.api
      instanceOf nomnom.cell1.orders.consumer
      instanceOf nomnom.cell1.orders.worker
    }
    namespace restaurantsNs 'nomnom-restaurants' {
      instanceOf nomnom.cell1.restaurants.api
      instanceOf nomnom.cell1.restaurants.consumer
    }
    namespace deliveryNs 'nomnom-delivery' {
      instanceOf nomnom.cell1.delivery.api
      instanceOf nomnom.cell1.delivery.worker
    }
    namespace paymentsNs 'nomnom-payments' {
      instanceOf nomnom.cell1.payments.api
    }
    namespace authzNs 'nomnom-authz' {
      instanceOf nomnom.spicedb
    }
    namespace dataNs 'nomnom-data' {
      instanceOf nomnom.dex
      ordersDb = instanceOf nomnom.cell1.orders.db
      restaurantsDb = instanceOf nomnom.cell1.restaurants.db
      instanceOf nomnom.cell1.restaurants.cache
      deliveryDb = instanceOf nomnom.cell1.delivery.db
      instanceOf nomnom.cell1.delivery.tracks
      paymentsDb = instanceOf nomnom.cell1.payments.db
    }
    namespace infraNs 'nomnom-infra' {
      instanceOf nomnom.cell1.messaging.debezium
      instanceOf nomnom.cell1.messaging.schemaRegistry
      instanceOf nomnom.cell1.messaging.integrationEvents
      instanceOf nomnom.cell1.messaging.changeNotifications
      instanceOf nomnom.cell1.temporal
    }
    namespace observabilityNs 'nomnom-observability' {
      instanceOf nomnom.observability
    }
  }
}
