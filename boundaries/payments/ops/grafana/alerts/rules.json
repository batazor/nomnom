{
  "folderUid": "nomnom",
  "interval": 60,
  "rules": [
    {
      "annotations": {
        "dashboard_url": "/d/nomnom-payments-overview",
        "summary": "Больше 5% входящих gRPC-вызовов завершаются техническими кодами (UNAVAILABLE, INTERNAL, DEADLINE_EXCEEDED…)."
      },
      "condition": "C",
      "data": [
        {
          "datasourceUid": "${metrics}",
          "model": {
            "expr": "sum by (job) (rate(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\", rpc_response_status_code=~\"CANCELLED|DEADLINE_EXCEEDED|RESOURCE_EXHAUSTED|UNAVAILABLE|UNKNOWN|UNIMPLEMENTED|INTERNAL|DATA_LOSS\"}[5m])) / sum by (job) (rate(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\"}[5m]))",
            "instant": true,
            "range": false,
            "refId": "A"
          },
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          }
        },
        {
          "datasourceUid": "__expr__",
          "model": {
            "expression": "$A \u003e 0.05",
            "refId": "C",
            "type": "math"
          },
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          }
        }
      ],
      "execErrState": "Error",
      "folderUID": "nomnom",
      "for": "10m",
      "labels": {
        "nomnom_dashboard": "nomnom-payments-overview",
        "severity": "critical"
      },
      "noDataState": "OK",
      "orgID": 0,
      "ruleGroup": "payments",
      "title": "Payments: gRPC technical errors",
      "uid": "nomnom-payments-grpc-errors"
    },
    {
      "annotations": {
        "dashboard_url": "/d/nomnom-payments-overview",
        "summary": "p95 входящих gRPC-вызовов дольше 1 s."
      },
      "condition": "C",
      "data": [
        {
          "datasourceUid": "${metrics}",
          "model": {
            "expr": "histogram_quantile(0.95, sum by (job, le) (rate(rpc_server_call_duration_seconds_bucket{job=~\"nomnom/(payments)\"}[5m])))",
            "instant": true,
            "range": false,
            "refId": "A"
          },
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          }
        },
        {
          "datasourceUid": "__expr__",
          "model": {
            "expression": "$A \u003e 1",
            "refId": "C",
            "type": "math"
          },
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          }
        }
      ],
      "execErrState": "Error",
      "folderUID": "nomnom",
      "for": "10m",
      "labels": {
        "nomnom_dashboard": "nomnom-payments-overview",
        "severity": "warning"
      },
      "noDataState": "OK",
      "orgID": 0,
      "ruleGroup": "payments",
      "title": "Payments: gRPC p95 latency",
      "uid": "nomnom-payments-grpc-latency"
    },
    {
      "annotations": {
        "dashboard_url": "/d/nomnom-payments-overview",
        "summary": "Error budget SLO Availability 99.9% расходуется в 14.4 раз быстрее допустимого за 1h и 5m."
      },
      "condition": "C",
      "data": [
        {
          "datasourceUid": "${metrics}",
          "model": {
            "expr": "(sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\", rpc_response_status_code=~\"CANCELLED|DEADLINE_EXCEEDED|RESOURCE_EXHAUSTED|UNAVAILABLE|UNKNOWN|UNIMPLEMENTED|INTERNAL|DATA_LOSS\"}[1h])) / sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\"}[1h]))) / 0.001 and (sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\", rpc_response_status_code=~\"CANCELLED|DEADLINE_EXCEEDED|RESOURCE_EXHAUSTED|UNAVAILABLE|UNKNOWN|UNIMPLEMENTED|INTERNAL|DATA_LOSS\"}[5m])) / sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\"}[5m]))) / 0.001 > 14.4",
            "instant": true,
            "range": false,
            "refId": "A"
          },
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          }
        },
        {
          "datasourceUid": "__expr__",
          "model": {
            "expression": "$A \u003e 14.4",
            "refId": "C",
            "type": "math"
          },
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          }
        }
      ],
      "execErrState": "Error",
      "folderUID": "nomnom",
      "for": "2m",
      "labels": {
        "nomnom_dashboard": "nomnom-payments-overview",
        "severity": "critical"
      },
      "noDataState": "OK",
      "orgID": 0,
      "ruleGroup": "payments",
      "title": "Payments: Availability SLO burn rate 1h",
      "uid": "nomnom-payments-slo-availability-fast"
    },
    {
      "annotations": {
        "dashboard_url": "/d/nomnom-payments-overview",
        "summary": "Error budget SLO Availability 99.9% расходуется в 6 раз быстрее допустимого за 6h и 30m."
      },
      "condition": "C",
      "data": [
        {
          "datasourceUid": "${metrics}",
          "model": {
            "expr": "(sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\", rpc_response_status_code=~\"CANCELLED|DEADLINE_EXCEEDED|RESOURCE_EXHAUSTED|UNAVAILABLE|UNKNOWN|UNIMPLEMENTED|INTERNAL|DATA_LOSS\"}[6h])) / sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\"}[6h]))) / 0.001 and (sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\", rpc_response_status_code=~\"CANCELLED|DEADLINE_EXCEEDED|RESOURCE_EXHAUSTED|UNAVAILABLE|UNKNOWN|UNIMPLEMENTED|INTERNAL|DATA_LOSS\"}[30m])) / sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\"}[30m]))) / 0.001 > 6",
            "instant": true,
            "range": false,
            "refId": "A"
          },
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          }
        },
        {
          "datasourceUid": "__expr__",
          "model": {
            "expression": "$A \u003e 6",
            "refId": "C",
            "type": "math"
          },
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          }
        }
      ],
      "execErrState": "Error",
      "folderUID": "nomnom",
      "for": "15m",
      "labels": {
        "nomnom_dashboard": "nomnom-payments-overview",
        "severity": "warning"
      },
      "noDataState": "OK",
      "orgID": 0,
      "ruleGroup": "payments",
      "title": "Payments: Availability SLO burn rate 6h",
      "uid": "nomnom-payments-slo-availability-slow"
    },
    {
      "annotations": {
        "dashboard_url": "/d/nomnom-payments-overview",
        "summary": "Error budget SLO Latency ≤ 0.25s 95% расходуется в 14.4 раз быстрее допустимого за 1h и 5m."
      },
      "condition": "C",
      "data": [
        {
          "datasourceUid": "${metrics}",
          "model": {
            "expr": "(1 - sum by (job) (increase(rpc_server_call_duration_seconds_bucket{job=~\"nomnom/(payments)\", le=\"0.25\"}[1h])) / sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\"}[1h]))) / 0.05 and (1 - sum by (job) (increase(rpc_server_call_duration_seconds_bucket{job=~\"nomnom/(payments)\", le=\"0.25\"}[5m])) / sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\"}[5m]))) / 0.05 > 14.4",
            "instant": true,
            "range": false,
            "refId": "A"
          },
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          }
        },
        {
          "datasourceUid": "__expr__",
          "model": {
            "expression": "$A \u003e 14.4",
            "refId": "C",
            "type": "math"
          },
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          }
        }
      ],
      "execErrState": "Error",
      "folderUID": "nomnom",
      "for": "2m",
      "labels": {
        "nomnom_dashboard": "nomnom-payments-overview",
        "severity": "critical"
      },
      "noDataState": "OK",
      "orgID": 0,
      "ruleGroup": "payments",
      "title": "Payments: Latency ≤ 0.25s SLO burn rate 1h",
      "uid": "nomnom-payments-slo-latency-fast"
    },
    {
      "annotations": {
        "dashboard_url": "/d/nomnom-payments-overview",
        "summary": "Error budget SLO Latency ≤ 0.25s 95% расходуется в 6 раз быстрее допустимого за 6h и 30m."
      },
      "condition": "C",
      "data": [
        {
          "datasourceUid": "${metrics}",
          "model": {
            "expr": "(1 - sum by (job) (increase(rpc_server_call_duration_seconds_bucket{job=~\"nomnom/(payments)\", le=\"0.25\"}[6h])) / sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\"}[6h]))) / 0.05 and (1 - sum by (job) (increase(rpc_server_call_duration_seconds_bucket{job=~\"nomnom/(payments)\", le=\"0.25\"}[30m])) / sum by (job) (increase(rpc_server_call_duration_seconds_count{job=~\"nomnom/(payments)\"}[30m]))) / 0.05 > 6",
            "instant": true,
            "range": false,
            "refId": "A"
          },
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          }
        },
        {
          "datasourceUid": "__expr__",
          "model": {
            "expression": "$A \u003e 6",
            "refId": "C",
            "type": "math"
          },
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          }
        }
      ],
      "execErrState": "Error",
      "folderUID": "nomnom",
      "for": "15m",
      "labels": {
        "nomnom_dashboard": "nomnom-payments-overview",
        "severity": "warning"
      },
      "noDataState": "OK",
      "orgID": 0,
      "ruleGroup": "payments",
      "title": "Payments: Latency ≤ 0.25s SLO burn rate 6h",
      "uid": "nomnom-payments-slo-latency-slow"
    }
  ],
  "title": "payments"
}
