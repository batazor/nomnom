SERVER__PORT=8084
MANAGEMENT__PORT=9084
SHUTDOWN__READINESS_DELAY=5s
SHUTDOWN__DRAIN_TIMEOUT=20s
# Service identity (ADR 27) и user assertions BFF (ADR 32) обязательны: пустое значение —
# процесс не стартует.
IDENTITY__ISSUER=
IDENTITY__AUDIENCE=nomnom.payments
IDENTITY__JWKS_FILE=
IDENTITY__SERVICE_ACCOUNTS=
IDENTITY__USER_ISSUER=
IDENTITY__USER_JWKS_FILE=
IDENTITY__USER_DELEGATES=
# Authorization через SpiceDB (ADR 18); пустой endpoint — все permissions запрещены.
# При заданном endpoint preshared key обязателен; INSECURE=true — plaintext только локально.
SPICEDB__ENDPOINT=
SPICEDB__PRESHARED_KEY=
SPICEDB__INSECURE=false
SPICEDB__TIMEOUT=2s
# Снапшот Payment пишется, когда commit проходит кратное этому числу (локальный ADR 2).
# Обязателен: пустое или меньше 1 — процесс не стартует.
EVENT_STORE__SNAPSHOT_EVERY=5
# Секреты ключей субъектов (crypto-shredding, локальный ADR 2), случайные, не короче 32 символов.
# Обязательны: без них процесс не стартует. В кластере приходят из Secret.
# KEKS — JSON {"<версия>": "<KEK>"}; новые ключи оборачивает старшая версия.
EVENT_STORE__SUBJECT_KEKS=
# REF_KEY не меняется при ротации KEK, иначе пользователя не найти для забвения.
EVENT_STORE__SUBJECT_REF_KEY=
