# Секреты процесса payments: только env, в кластере — из Secret. Несекретные настройки —
# в файле CONFIG_FILE (config.example.yaml); переменные SECTION__KEY для них не читаются.
# make run читает этот файл как .env.
# PostgreSQL connection URI (postgresql://…); обязателен.
DATABASE__URI=
# Preshared key SpiceDB (ADR 18); обязателен при spec.spicedb.endpoint.
SPICEDB__PRESHARED_KEY=
# Секреты ключей субъектов (crypto-shredding, локальный ADR 2), случайные, не короче 32 символов.
# Обязательны: без них процесс не стартует.
# KEKS — JSON {"<версия>": "<KEK>"}; новые ключи оборачивает старшая версия.
EVENT_STORE__SUBJECT_KEKS=
# REF_KEY не меняется при ротации KEK, иначе пользователя не найти для забвения.
EVENT_STORE__SUBJECT_REF_KEY=
# Общий секрет HMAC подписи webhooks провайдера; обязателен.
PROVIDER__WEBHOOK_SECRET=
# Ключ Stripe test mode (sk_test_...); обязателен при spec.provider.kind: stripe.
PROVIDER__STRIPE_API_KEY=
