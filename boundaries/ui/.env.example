VITE_PUBLIC_GRAPHQL_URL=http://localhost:3010/graphql
VITE_LOCALE=ru
VITE_ENABLE_MOCKS=true
# Faro collector (Alloy faro.receiver); empty — browser telemetry is off.
VITE_FARO_URL=
VITE_DEPLOYMENT_ENVIRONMENT=development
# Browser login through Dex in kind (ADR 35); empty — sign-in buttons are hidden.
# kubectl -n nomnom-data port-forward svc/dex 5556
VITE_OIDC_ISSUER=
# Defaults: client nomnom-ui, BFF audience nomnom-bff.
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=
