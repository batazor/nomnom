# Public API through the public gateway of kind (ADR 41): GET /markets and /m/{market}/graphql.
VITE_PUBLIC_API_URL=https://api.nomnom.localhost:18085
VITE_LOCALE=ru
VITE_ENABLE_MOCKS=true
# Faro collector (Alloy faro.receiver); empty — browser telemetry is off.
VITE_FARO_URL=
# Required with VITE_FARO_URL.
VITE_APP_VERSION=
VITE_DEPLOYMENT_ENVIRONMENT=development
# Browser login through Dex in kind (ADR 35); required unless VITE_ENABLE_MOCKS=true.
# In kind: https://auth.nomnom.localhost:18085/dex (public gateway), or http://localhost:<port>/dex
# through the dev server proxy (NOMNOM_AUTH_PROXY_TARGET and NOMNOM_API_PROXY_CA).
VITE_OIDC_ISSUER=
# Required with VITE_OIDC_ISSUER: client nomnom-ui, BFF audience nomnom-bff.
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=
# Demo user of kind shown next to sign-in: demo@domain / password.
VITE_OIDC_DEMO_EMAIL_DOMAIN=
VITE_OIDC_DEMO_PASSWORD=
