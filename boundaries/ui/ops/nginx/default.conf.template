# Origin of the customer UI (local ADR 2 of UI): static files of `vite build`, SPA fallback
# to index.html. Cloudflare in front caches only what these headers allow (AGENTS.md, Edge):
# hashed assets are immutable, index.html and config.js are revalidated every time.
# The nginx image renders ${...} from the environment at start (docker-entrypoint.d).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Probes of the Pod; not part of the app.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Environment of the deployment (ConfigMap of the chart): a new value is visible on the
    # next page load.
    location = /config.js {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
