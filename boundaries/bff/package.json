{
  "name": "bff",
  "version": "0.1.0",
  "private": true,
  "description": "nomnom client BFF powered by WunderGraph Cosmo",
  "scripts": {
    "generate": "wgc router plugin generate plugins/bff",
    "test": "wgc router plugin test plugins/bff",
    "build": "wgc router plugin build plugins/bff --debug",
    "compose": "wgc router compose --input graph.yaml --out config.json",
    "router:download": "wgc router download-binary --out release",
    "start": "./release/router",
    "check": "npm run generate && npm test && npm run build && npm run compose"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "wgc": "0.133.3"
  }
}
