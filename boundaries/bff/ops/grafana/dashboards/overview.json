      {
        "kind": "QueryVariable",
        "spec": {
          "name": "environment",
          "current": {
            "text": "",
            "value": ""
          },
          "label": "Environment",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${metrics}"
            },
            "spec": {
              "qryType": 1,
              "query": "label_values(target_info{job=~\"nomnom/(bff)\"}, deployment_environment_name)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "alphabeticalAsc",
          "definition": "label_values(target_info{job=~\"nomnom/(bff)\"}, deployment_environment_name)",
          "options": [],
