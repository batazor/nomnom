{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "nomnom-bff-overview"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Overview bounded context bff: health, runtime, зависимости и бизнес-поток. Сгенерировано ops/grafana; правки — через генератор.",
    "editable": false,
    "elements": {
      "panel-17": {
        "kind": "Panel",
        "spec": {
          "id": 17,
          "title": "Time to expiry",
          "description": "До NotAfter. cert-manager продлевает заранее (renewBefore), срок не должен приближаться к нулю.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${metrics}"
                      },
                      "spec": {
                        "expr": "min by (namespace, name) (certmanager_certificate_not_after_timestamp_seconds{job=\"infra/cert-manager\", namespace=\"nomnom-bff\"}) - time()",
                        "legendFormat": "{{namespace}}/{{name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-18": {
        "kind": "Panel",
        "spec": {
          "id": 18,
          "title": "Time to scheduled renewal",
          "description": "Отрицательное значение — продление просрочено: issuer не выпускает сертификат.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${metrics}"
                      },
                      "spec": {
                        "expr": "min by (namespace, name) (certmanager_certificate_renewal_timestamp_seconds{job=\"infra/cert-manager\", namespace=\"nomnom-bff\"}) - time()",
                        "legendFormat": "{{namespace}}/{{name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-19": {
        "kind": "Panel",
        "spec": {
          "id": 19,
          "title": "Ready",
          "description": "0 — Certificate не Ready: сертификат не выпущен, просрочен или не совпадает со spec.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${metrics}"
                      },
                      "spec": {
                        "expr": "min by (namespace, name) (certmanager_certificate_ready_status{job=\"infra/cert-manager\", namespace=\"nomnom-bff\", condition=\"True\"})",
                        "legendFormat": "{{namespace}}/{{name}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-20": {
        "kind": "Panel",
        "spec": {
          "id": 20,
          "title": "About",
          "description": "Сводка о сервисе и ссылки на соседние инструменты.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "# BFF\n\n## Сервис\n\n| | |\n| --- | --- |\n| Процессы | `bff` |\n| Язык | `cosmo` |\n\n## Сигналы\n\n- [Logs (Loki)](/explore?schemaVersion=1\u0026panes=%7B%22nomnom%22%3A%7B%22datasource%22%3A%22${logs}%22%2C%22queries%22%3A%5B%7B%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22${logs}%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D~%5C%22${service:pipe}%5C%22%2C+deployment_environment_name%3D~%5C%22$environment%5C%22%7D+%7C+service_version%3D~%5C%22${version:regex}%5C%22%22%2C%22queryType%22%3A%22range%22%2C%22refId%22%3A%22A%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D)\n- [Traces (Tempo)](/explore?schemaVersion=1\u0026panes=%7B%22nomnom%22%3A%7B%22datasource%22%3A%22${traces}%22%2C%22queries%22%3A%5B%7B%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22${traces}%22%7D%2C%22limit%22%3A20%2C%22query%22%3A%22%7Bresource.service.name%3D~%5C%22${service:pipe}%5C%22+%26%26+resource.deployment.environment.name%3D~%5C%22$environment%5C%22%7D%22%2C%22queryType%22%3A%22traceql%22%2C%22refId%22%3A%22A%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D)\n- [Traces: errors](/explore?schemaVersion=1\u0026panes=%7B%22nomnom%22%3A%7B%22datasource%22%3A%22${traces}%22%2C%22queries%22%3A%5B%7B%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22${traces}%22%7D%2C%22limit%22%3A20%2C%22query%22%3A%22%7Bresource.service.name%3D~%5C%22${service:pipe}%5C%22+%26%26+resource.deployment.environment.name%3D~%5C%22$environment%5C%22+%26%26+status%3Derror%7D%22%2C%22queryType%22%3A%22traceql%22%2C%22refId%22%3A%22A%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D)\n- [Profiles (Pyroscope)](/explore?schemaVersion=1\u0026panes=%7B%22nomnom%22%3A%7B%22datasource%22%3A%22${profiles}%22%2C%22queries%22%3A%5B%7B%22datasource%22%3A%7B%22type%22%3A%22grafana-pyroscope-datasource%22%2C%22uid%22%3A%22${profiles}%22%7D%2C%22labelSelector%22%3A%22%7Bservice_name%3D~%5C%22${service:pipe}%5C%22%2C+deployment_environment_name%3D~%5C%22$environment%5C%22%7D%22%2C%22profileTypeId%22%3A%22process_cpu%3Acpu%3Ananoseconds%3Acpu%3Ananoseconds%22%2C%22queryType%22%3A%22profile%22%2C%22refId%22%3A%22A%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D)\n\n## Документация\n\n- [Dashboard README](https://github.com/batazor/nomnom/blob/main/boundaries/bff/ops/grafana/README.md)\n- [Metric inventory](https://github.com/batazor/nomnom/blob/main/docs/observability/metric-inventory.md)\n\n## Соседние dashboards\n\n- [Platform / Overview](/d/nomnom-platform-overview)\n\n"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
