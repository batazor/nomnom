  "query": "SELECT o.id, o.delivery_id, d.order_id, d.pickup_address, o.expires_at\n             FROM delivery_offers o JOIN deliveries d ON d.id = o.delivery_id\n             WHERE o.courier_id = $1 AND o.state = 'pending'\n             ORDER BY o.position",
