SERVER__PORT=8082
MANAGEMENT__PORT=9082
SHUTDOWN__READINESS_DELAY=5s
SHUTDOWN__DRAIN_TIMEOUT=20s
# Service identity (ADR 27); пустые значения — RejectingSubjectResolver.
IDENTITY__ISSUER=
IDENTITY__AUDIENCE=
IDENTITY__JWKS_FILE=
IDENTITY__SERVICE_ACCOUNTS=
# User assertions BFF (ADR 32); без issuer, JWKS и делегатов вызовы с assertion отклоняются.
IDENTITY__USER_ISSUER=
IDENTITY__USER_JWKS_FILE=
IDENTITY__USER_DELEGATES=
# SpiceDB (ADR 18); пустой endpoint — restaurants не стартует. Локально: localhost:50051, devkey, INSECURE=true.
SPICEDB__ENDPOINT=
SPICEDB__PRESHARED_KEY=
SPICEDB__INSECURE=false
SPICEDB__TIMEOUT=2s
# MongoDB replica set (ADR 8); обязателен. Локально: mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB__URI=
MONGODB__DATABASE=restaurants
MONGODB__TIMEOUT=5s
# Connection pool процесса; пусто — default процесса (MAX_POOL_SIZE: restaurants 20, consumer 5).
MONGODB__MAX_POOL_SIZE=
MONGODB__MIN_POOL_SIZE=0
MONGODB__MAX_IDLE_TIME=5m
MONGODB__WAIT_QUEUE_TIMEOUT=5s
MONGODB__MAX_CONNECTING=
# Valkey, кеш GetRestaurant/GetMenu/ListRestaurants (ADR 43); обязателен для restaurants и restaurants-consumer. Локально: redis://localhost:6379
VALKEY__URL=
VALKEY__COMMAND_TIMEOUT=50ms
CACHE__TTL=1m
# Consumer group restaurants-consumer, которая обновляет кеш по restaurant-events и menu-events.
CACHE__REFRESH_GROUP=restaurants-cache
# Reconciliation restaurant#owner/staff (FR-445); фоновый цикл в процессе.
RECONCILER__INTERVAL=5m
RECONCILER__GRACE=10m
RECONCILER__PAGE_SIZE=500
# Открытые продуктовые решения команд кухни: начальный expected_ready_at, повтор Start Preparation/Mark Ready, отмена во время Preparation.
KITCHEN__PREPARATION_TIME=20m
KITCHEN__REPEAT_POLICY=succeed-without-event
KITCHEN__CANCELLATION_DURING_PREPARATION=reject
# Kitchen Queue (FR-241): обычный заказ, ждущий дольше стольких базовых времён ожидания, идёт вместе с премиум-заказами.
KITCHEN_QUEUE__AGING_FACTOR=2
# Wait Time Statistics (FR-645, FR-657): выборка базового времени, окно недавней медианы и пороги уровня
# (ELEVATED выше FACTOR базовых, NORMAL снова не выше NORMAL_FACTOR). Нужны restaurants и restaurants-consumer;
# пока выборка не набрана, базовое время — KITCHEN__PREPARATION_TIME.
WAIT_TIME__SAMPLE_SIZE=50
WAIT_TIME__RECENT_WINDOW=30m
WAIT_TIME__ELEVATED_FACTOR=1.5
WAIT_TIME__NORMAL_FACTOR=1.2
# Demo Simulator кухни (FR-605, FR-606); обязательны для restaurants: период прохода и границы случайной задержки действия (MIN_DELAY <= MAX_DELAY).
SIMULATOR__INTERVAL=5s
SIMULATOR__MIN_DELAY=30s
SIMULATOR__MAX_DELAY=2m
# Окна доставки запланированных заказов (FR-694); обязательны для restaurants, без default в коде:
# ширина окна (MUST делить 30 минут), первое окно не раньше now + MIN_LEAD, окна до now + MAX_HORIZON
# (MIN_LEAD < MAX_HORIZON; MAX_HORIZON MUST быть меньше срока жизни Authorization hold у provider),
# срок hold резервации и число альтернативных окон при заполненном окне.
SCHEDULED_SLOT__WIDTH=15m
SCHEDULED_SLOT__MIN_LEAD=45m
SCHEDULED_SLOT__MAX_HORIZON=48h
SCHEDULED_SLOT__HOLD_TTL=10m
SCHEDULED_SLOT__ALTERNATIVES=3
# restaurants-consumer (ADR 28): обязателен для него; основной процесс к Kafka не подключается, Outbox публикует Debezium (ADR 37). Локально: localhost:9092
KAFKA__BROKERS=
KAFKA__CLIENT_ID=restaurants-consumer
# restaurants-consumer: consumer group, начальный offset новой группы (oldest|newest) и повторы transient-ошибок в процессе.
KAFKA__CONSUMER_GROUP=restaurants
KAFKA__INITIAL_OFFSET=oldest
CONSUMER__MAX_RETRIES=5
CONSUMER__RETRY_INITIAL_INTERVAL=100ms
CONSUMER__RETRY_MAX_INTERVAL=5s
# OTLP export метрик только при заданном endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
