# Секреты локального запуска (ADR 17): только они читаются из env, остальная конфигурация —
# файл CONFIG_FILE (config.example.yaml, config.consumer.example.yaml). Переменные, уже
# заданные в окружении, имеют приоритет над .env.
# MongoDB replica set (ADR 8); обязателен.
MONGODB__URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
# Valkey (ADR 43); обязателен restaurants и restaurants-consumer.
VALKEY__URL=redis://localhost:6379
# SpiceDB (ADR 18); обязателен restaurants.
SPICEDB__PRESHARED_KEY=devkey
