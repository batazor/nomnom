SERVER__PORT=8082
MANAGEMENT__PORT=9082
SHUTDOWN__READINESS_DELAY=5s
SHUTDOWN__DRAIN_TIMEOUT=20s
# Service identity (ADR 27); пустые значения — RejectingSubjectResolver.
IDENTITY__ISSUER=
IDENTITY__AUDIENCE=
IDENTITY__JWKS_FILE=
IDENTITY__SERVICE_ACCOUNTS=
# User assertions BFF (ADR 32); без issuer, JWKS и делегатов вызовы с assertion отклоняются.
IDENTITY__USER_ISSUER=
IDENTITY__USER_JWKS_FILE=
IDENTITY__USER_DELEGATES=
# SpiceDB (ADR 18); пустой endpoint — in-memory deny-all. Локально: localhost:50051, devkey, INSECURE=true.
SPICEDB__ENDPOINT=
SPICEDB__PRESHARED_KEY=
SPICEDB__INSECURE=false
SPICEDB__TIMEOUT=2s
# MongoDB replica set (ADR 8); обязателен. Локально: mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB__URI=
MONGODB__DATABASE=restaurants
MONGODB__TIMEOUT=5s
# Reconciliation restaurant#owner/staff (FR-445); фоновый цикл в процессе.
RECONCILER__INTERVAL=5m
RECONCILER__GRACE=10m
RECONCILER__PAGE_SIZE=500
# restaurants-relay (ADR 31): обязателен для relay, основной процесс к Kafka не подключается. Локально: localhost:9092
KAFKA__BROKERS=
KAFKA__CLIENT_ID=restaurants-relay
OUTBOX__RETENTION=7d
OUTBOX__POLL_INTERVAL=1s
OUTBOX__BATCH_SIZE=100
OUTBOX__LEASE_TTL=15s
# OTLP export метрик только при заданном endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
