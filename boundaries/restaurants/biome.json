{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "cmd/**/*.ts",
      "di/**/*.ts",
      "infrastructure/grpc/service.ts",
      "infrastructure/grpc/subject.ts",
      "infrastructure/grpc/worker.ts",
      "infrastructure/spicedb/**/*.ts",
      "pkg/**/*.ts",
      "slices/**/*.ts",
      "test/**/*.ts",
      "*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
