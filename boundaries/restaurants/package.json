{
  "name": "@nomnom/restaurants",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json && cp -R infrastructure/grpc/gen dist/infrastructure/grpc/",
    "check": "npm run proto:check && biome check .",
    "format": "biome format --write .",
    "generate:proto": "cd infrastructure/grpc && buf generate --template buf.gen.yaml",
    "lint": "biome lint .",
    "proto:check": "cd ../.. && buf format --diff --exit-code && buf lint && buf build",
    "start": "node cmd/restaurants/main.ts",
    "relay": "node cmd/restaurants-relay/main.ts",
    "consumer": "node cmd/restaurants-consumer/main.ts",
    "test": "node --test test/*.test.ts",
    "migrate": "node cmd/restaurants-migrate/main.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@authzed/authzed-node": "1.6.1",
    "@bufbuild/protobuf": "2.16.0",
    "@confluentinc/kafka-javascript": "1.11.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "awilix": "13.0.5",
    "decimal.js": "^10.6.0",
    "jose": "6.2.13",
    "mongodb": "7.7.0",
    "zod": "^4.6.7"
  }
}
