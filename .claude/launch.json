{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "customer-ui-mocks",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "boundaries/ui",
        "vite",
        "boundaries/ui",
        "--port",
        "4173",
        "--strictPort"
      ],
      "env": {
        "VITE_PUBLIC_GRAPHQL_URL": "http://localhost:4173/graphql",
        "VITE_LOCALE": "ru",
        "VITE_ENABLE_MOCKS": "true",
        "VITE_DEPLOYMENT_ENVIRONMENT": "development"
      },
      "port": 4173
    },
    {
      "name": "customer-ui-preview-mocks",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd boundaries/ui && npx vite build && npx vite preview --port 4187 --strictPort"
      ],
      "env": {
        "VITE_PUBLIC_GRAPHQL_URL": "http://localhost:4187/graphql",
        "VITE_LOCALE": "ru",
        "VITE_ENABLE_MOCKS": "true",
        "VITE_DEPLOYMENT_ENVIRONMENT": "development"
      },
      "port": 4187
    },
    {
      "name": "customer-ui-kind-login",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "boundaries/ui",
        "vite",
        "boundaries/ui",
        "--port",
        "4180",
        "--strictPort"
      ],
      "env": {
        "VITE_PUBLIC_GRAPHQL_URL": "http://localhost:3010/graphql",
        "VITE_LOCALE": "ru",
        "VITE_ENABLE_MOCKS": "false",
        "VITE_OIDC_ISSUER": "http://localhost:5556/dex",
        "VITE_DEPLOYMENT_ENVIRONMENT": "kind",
        "VITE_OIDC_CLIENT_ID": "nomnom-ui",
        "VITE_OIDC_AUDIENCE": "nomnom-bff",
        "VITE_OIDC_DEMO_EMAIL_DOMAIN": "nomnom.test",
        "VITE_OIDC_DEMO_PASSWORD": "nomnom"
      },
      "port": 4180,
      "autoPort": false
    }
  ]
}
