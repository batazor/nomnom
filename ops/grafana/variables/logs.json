{
  "apiVersion": "dashboard.grafana.app/v2beta1",
  "kind": "Variable",
  "metadata": {
    "name": "logs"
  },
  "spec": {
    "kind": "DatasourceVariable",
    "spec": {
      "name": "logs",
      "pluginId": "loki",
      "refresh": "onDashboardLoad",
      "regex": "/^(?!.*(alert-state-history|usage)).*$/",
      "current": {
        "text": "",
        "value": ""
      },
      "options": [],
      "multi": false,
      "includeAll": false,
      "label": "Logs (Loki)",
      "hide": "dontHide",
      "skipUrlSync": false,
      "allowCustomValue": true
    }
  }
}
