# Версии тестового kind-окружения вне Skaffold. Версии charts Cilium и Envoy Gateway
# закреплены в skaffold/skaffold.yaml (Skaffold не подставляет environment в версии charts).
# Формат KEY=VALUE читают Make (include) и bash (source).
# Образы chart ops/kind/bootstrap закреплены в его values.yaml.
# Политика: последние стабильные релизы на дату обновления (2026-10-24).
# Kubernetes 1.37 новее протестированных диапазонов Cilium 1.20 (1.33–1.36) и
# Envoy Gateway 1.9 (1.33–1.36); совместимость подтверждается прогоном make kind-e2e.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
SKAFFOLD_VERSION=v2.25.0
# Gateway API CRD устанавливаются chart Envoy Gateway v1.9.2; значение проверяется по
# аннотации gateway.networking.k8s.io/bundle-version после установки.
GATEWAY_API_VERSION=v1.6.1
# Kind E2E (ops/kind/e2e): Kyverno Chainsaw, запускается через go run без установки.
CHAINSAW_VERSION=v0.2.15
