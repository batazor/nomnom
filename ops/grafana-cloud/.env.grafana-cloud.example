# Grafana Cloud (free tier) для проверки dashboards и метрик. Скопировать в
# ops/grafana-cloud/.env.grafana-cloud (игнорируется git) и заполнить.

# Stack URL: https://<stack>.grafana.net
GRAFANA_CLOUD_STACK_URL=

# My Account → stack → OpenTelemetry → Configure: endpoint и Instance ID.
# Пример endpoint: https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_INSTANCE_ID=

# Access policy token (scope metrics:write) — для Alloy в kind.
GRAFANA_CLOUD_OTLP_TOKEN=

# Service account token в самом stack (роль Editor) — для gcx и Grafana MCP.
GRAFANA_CLOUD_SA_TOKEN=
